# ============================================
# FlowMind 环境配置示例
# ============================================
# 复制此文件为 .env 并填入你的配置
# ============================================

# --------------------------------------------
# AI 提供商配置（至少配置一个）
# --------------------------------------------
DEEPSEEK_API_KEY=your_deepseek_api_key
# ARK_API_KEY=your_ark_api_key  # 火山引擎 API 密钥（可选）
# ARK_MODEL=doubao-pro-32k  # 火山引擎模型名称

# --------------------------------------------
# 本地大模型与 AI 混合路由网关（可选；PRD：本地优先混合算力）
# --------------------------------------------
# 配置任一本地 OpenAI 兼容服务后，AI 网关将“本地优先”，仅复杂推理溢出云端。
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5
# OLLAMA_VISION=true                  # 本地服务是否支持视觉(VLM)，用于 ai_click 视觉自愈
# VLLM_BASE_URL=http://localhost:8001/v1
# VLLM_MODEL=Qwen2-VL-7B-Instruct
# VLLM_VISION=true
# ARK_VISION=false                    # 云端豆包是否按多模态参与视觉定位

# --------------------------------------------
# RPA 执行引擎（rpa_flow 插件，可选）
# --------------------------------------------
# Worker 调用 Orchestrator AI 网关的地址，启用 ai_click/ai_extract 视觉自愈
# FLOWMIND_AI_GATEWAY_URL=http://127.0.0.1:8000
# save_db 动作写入的 SQLite 路径
# RPA_RESULTS_DB=data/rpa_results.db
# 失败现场快照（截图+HTML）输出目录
# RPA_SNAPSHOT_DIR=data/snapshots
# 浏览器扩展桥接：Native Messaging Host 回连此本机 WebSocket（见 browser_bridge/）
# FLOWMIND_BROWSER_BRIDGE_HOST=127.0.0.1
# FLOWMIND_BROWSER_BRIDGE_PORT=8777

# --------------------------------------------
# 服务器配置（Registry / Web）
# --------------------------------------------
REGISTRY_API_URL=http://127.0.0.1:8000

# --------------------------------------------
# 分布式部署（可选）：多 Registry 实例协调
# --------------------------------------------
# 配置 Redis 后，多个 Registry 实例可共享机器在线表、跨实例派发任务并回传结果，
# 以及使用分布式锁（如心跳超时清理去重）。不配置则为单实例内存模式，行为不变。
# REDIS_URL=redis://127.0.0.1:6379/0

# --------------------------------------------
# 安全配置（必填）
# --------------------------------------------
SECRET_KEY=your-secret-key-here  # 请设置一个强密码/随机字符串
FLOWMIND_ADMIN_USERNAME=admin
FLOWMIND_ADMIN_PASSWORD=your_password
# 如果未配置 FLOWMIND_ADMIN_PASSWORD，系统会在首次启动时
# 在 data/bootstrap_admin_password.txt 生成一次性 admin 密码

# --------------------------------------------
# 会话配置（可选）
# --------------------------------------------
# FLOWMIND_SESSION_TTL_SECONDS=86400  # 会话超时时间（秒）
# FLOWMIND_SESSION_COOKIE=flowmind_session
# FLOWMIND_SESSION_COOKIE_SECURE=false

# --------------------------------------------
# 调度中心（可选）
# --------------------------------------------
# FLOWMIND_SCHEDULER_ENABLED=true
# FLOWMIND_SCHEDULER_POLL_SECONDS=20
# FLOWMIND_SCHEDULER_CLAIM_BATCH_SIZE=3
# FLOWMIND_SCHEDULER_SESSION_TTL_SECONDS=7200

# --------------------------------------------
# Registry 侧 Agent 心跳清理配置（可选）
# --------------------------------------------
# AGENT_HEARTBEAT_TIMEOUT_SEC=45
# AGENT_HEARTBEAT_SWEEP_INTERVAL_SEC=15
# Registry 与 Agent WebSocket 之间的共享认证 token
# 启用后，Agent 注册时必须携带相同 token，否则会被 Registry 拒绝
# FLOWMIND_AGENT_WS_TOKEN=replace-with-shared-agent-ws-token

# --------------------------------------------
# Agent 专属配置
# --------------------------------------------
# Agent 连接、OCR、SMTP 等配置请复制 agent/.env.example 到 agent/.env

# --------------------------------------------
# 可选：远端 Agent 管理 API（供 Web 管理端调用）
# --------------------------------------------
# 单远端 Agent 场景可直接配置 AGENT_ADMIN_API_URL
# AGENT_ADMIN_API_URL=http://agent-host:8765
# 更明确的做法：把多机 token 放到独立 token store 文件，并按需自定义路径
# AGENT_ADMIN_TOKEN_STORE_PATH=data/agent_admin_tokens.json
# 参考样例：data/agent_admin_tokens.example.json
# 运行态文件建议 chmod 600，并补充 rotated_at / updated_at 元数据
# 如果启用了多台 Agent 的“目标机器选择”，请确保各 Agent 公开地址通过
# 各自的 AGENT_ADMIN_PUBLIC_URL 上报到 Registry
# 兼容回退：仍可继续使用环境变量方式
# AGENT_ADMIN_API_TOKEN=replace-with-agent-admin-token
# AGENT_ADMIN_API_TOKENS_JSON='{"machine-a":"token-for-agent-a","machine-b":"token-for-agent-b"}'
