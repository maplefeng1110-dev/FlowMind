# ============================================
# FlowMind Agent 环境配置示例
# ============================================
# 复制此文件为 agent/.env 并填入 Agent 侧配置
# ============================================

# --------------------------------------------
# Agent 连接 Registry 的配置
# --------------------------------------------
REGISTRY_URL=ws://127.0.0.1:8000/ws
MACHINE_ID=local-dev-machine
AGENT_HEARTBEAT_INTERVAL_SEC=10
# 与 Registry 侧保持一致的共享 WebSocket 认证 token
FLOWMIND_AGENT_WS_TOKEN=replace-with-shared-agent-ws-token

# --------------------------------------------
# OCR 配置（可选，invoice_ocr 插件使用）
# --------------------------------------------
# OCR_API_URL=http://your-ocr-api-url
# OCR_API_TIMEOUT=15

# --------------------------------------------
# 邮件配置（可选，send_email 插件使用）
# --------------------------------------------
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_email@example.com
# SMTP_PASSWORD=your_email_password

# --------------------------------------------
# Agent 管理 API（可选；用于远端插件脚手架/安装）
# --------------------------------------------
AGENT_ADMIN_ENABLED=true
AGENT_ADMIN_HOST=127.0.0.1
AGENT_ADMIN_PORT=8765
# 如果希望这台 Agent 能在 Web 管理端里被按机器选择，请配置一个 Web 可达的公开地址
# AGENT_ADMIN_PUBLIC_URL=https://agent-a.example.com
# 如果需要让其他主机远程调用 Agent 管理 API，请务必配置强随机 token
# AGENT_ADMIN_TOKEN=replace-with-a-random-token
